# Copy this file to ".env" for local use. On a host (Render, Railway, etc.) add these
# as private "environment variables" instead. NEVER put real keys in this example file.

# REQUIRED: your Claude API key from console.anthropic.com (create one just for IDEA)
ANTHROPIC_API_KEY=paste-your-key-here

# Models (change if you want cheaper or stronger ones)
MODEL_QUICK=claude-haiku-5-5
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-sonnet-5-5

# Cost protection
DAILY_AI_LIMIT_PER_USER=60
PORT=3000
# Hosted Postgres (Vercel adds this for you when you connect a database). If empty, a local SQLite file is used.
DATABASE_URL=
# Folder for the SQLite file (local/Render only). On a host, point this at a persistent disk or volume.
DATA_DIR=./data

# OPTIONAL: email delivery of documents (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IDEA by GIT GROUP <no-reply@yourdomain.com>
